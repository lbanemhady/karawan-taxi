rules_version = '2';

// ============================================================
// قواعد أمان أولية (Minimum Viable) — تسمح بالقراءة والكتابة للجميع
// حتى يعمل التطبيق فورًا بدون نظام تسجيل دخول متقدم.
//
// ⚠️ هذا غير آمن على المدى الطويل: أي شخص يعرف رابط قاعدة البيانات
// يقدر يقرأ/يعدّل البيانات مباشرة عبر واجهة Firebase البرمجية.
// قبل الانطلاق الفعلي بعدد كبير من السائقين، يُنصح بشدة بترقية هذا
// عبر إضافة Firebase Authentication (تحقق برقم الهاتف OTP) وتقييد
// الكتابة بحيث كل سائق يعدّل بياناته فقط، وقصر لوحة الشركة على
// حساب الموظفين. راجع: https://firebase.google.com/docs/firestore/security/get-started
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
